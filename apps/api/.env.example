APP_NAME=SYSGOV
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sysgov
DB_USERNAME=sysgov
DB_PASSWORD=secret
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
SANCTUM_STATEFUL_DOMAINS=localhost:5173
# Endereço público do Painel do Cliente (apps/web-client) — usado nos links dos e-mails
# transacionais (nunca APP_URL, que é o endereço da API).
PORTAL_URL=http://localhost:5174
# Em desenvolvimento, aponte para o Mailpit (docker compose): MAIL_MAILER=smtp,
# MAIL_HOST=mailpit, MAIL_PORT=1025, MAIL_ENCRYPTION=null. Sem SMTP configurado, o padrão é
# "log" (config/mail.php) e o envio conta como concluído sem enviar de fato.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=naoresponda@sysgov.com.br
MAIL_FROM_NAME=SYSGOV
