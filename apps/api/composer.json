{
  "name": "systrat/sysgov-api",
  "description": "API modular multi-tenant da plataforma SYSGOV",
  "license": "proprietary",
  "type": "project",
  "require": {"php": "^8.2", "laravel/framework": "^12.0", "laravel/sanctum": "^4.0", "nwidart/laravel-modules": "^11.0", "spatie/laravel-permission": "^6.0"},
  "autoload": {"psr-4": {"App\\": "app/", "Modules\\": "Modules/", "Database\\": "database/", "Tests\\": "Tests/"}},
  "config": {"allow-plugins": {"wikimedia/composer-merge-plugin": true}},
  "scripts": {"test": "vendor/bin/phpunit", "analyse": "vendor/bin/phpunit --testsuite=Feature", "lint": "find app Modules -type f -name '*.php' -print0 | xargs -0 -n1 php -l", "static": "vendor/bin/phpstan analyse --no-progress"},
  "require-dev": {
    "laravel/tinker": "^3.0",
    "phpunit/phpunit": "^12.5",
    "mockery/mockery": "^1.6",
    "phpstan/phpstan": "^2.2",
    "larastan/larastan": "^3.10"
  }
}
