{
  "name": "systrat/sysgov-api",
  "description": "API modular multi-tenant da plataforma SYSGOV",
  "license": "proprietary",
  "type": "project",
  "require": {"php": "^8.4", "laravel/framework": "^13.0", "laravel/sanctum": "^4.0", "nwidart/laravel-modules": "^13.0", "spatie/laravel-permission": "^6.0",
    "pragmarx/google2fa-laravel": "^3.0",
    "predis/predis": "^3.6"},
  "autoload": {
    "psr-4": {
        "App\\": "app/",
        "Modules\\": "Modules/",
        "Database\\": "database/",
        "Tests\\": "Tests/"
    },
    "files": [
        "app/Support/helpers.php"
    ]
},
  "config": {"allow-plugins": {"wikimedia/composer-merge-plugin": true}},
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "dev": [
      "@php artisan optimize:clear --ansi",
      "@php artisan serve --host=localhost --port=8000"
    ],
    "test": "vendor/bin/phpunit",
    "analyse": "vendor/bin/phpunit --testsuite=Feature",
    "lint": "find app Modules -type f -name '*.php' -print0 | xargs -0 -n1 php -l",
    "static": "vendor/bin/phpstan analyse --no-progress"
  },
  "require-dev": {
    "laravel/tinker": "^3.0",
    "phpunit/phpunit": "^12.5",
    "mockery/mockery": "^1.6",
    "phpstan/phpstan": "^2.2",
    "larastan/larastan": "^3.11",
    "laravel/telescope": "^5.23"
  }
}
