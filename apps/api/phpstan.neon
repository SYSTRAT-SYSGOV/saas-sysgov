includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 6
    paths:
        - app
        - Modules
    tmpDir: storage/framework/phpstan
    excludePaths:
        - */vendor/*
        - Modules/*/app/*
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Config de módulo é mesclada por mergeConfigFrom e entra no config:cache normalmente.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: Modules/*/Config/*
