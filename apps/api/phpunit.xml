<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Feature">
            <directory>Modules</directory>
            <directory>Tests</directory>
        </testsuite>
    </testsuites>
    <!-- Testes que exigem MySQL (ex.: concorrência com lockForUpdate) ficam fora da suíte
         padrão; rodar com: vendor/bin/phpunit, opção group=mysql -->
    <groups>
        <exclude>
            <group>mysql</group>
        </exclude>
    </groups>
    <php>
        <!-- force="true" em todas: o container de dev já define APP_ENV=local,
             CACHE_STORE=redis e SESSION_DRIVER=redis como env real do processo, que
             vence o <env> do phpunit.xml sem force — isso fazia os testes rodarem
             contra Redis real (cache vazando entre execuções) e com APP_ENV=local
             (bypass indevido de regras como MFA que só deveriam valer em bootstrap
             local de desenvolvimento, nunca em teste automatizado). -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="AUTH_GUARD" value="web" force="true"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
    </php>
</phpunit>
