# ==============================================================================
# SAAS FISCAL MULTI-TENANT — FRONTEND (React + Vite)
# ==============================================================================
# Copie este arquivo para '.env' e configure os valores correspondentes.
# O backend é gerenciado pelo Laravel em backend/.env
# ==============================================================================

# Frontend
VITE_APP_TITLE="SGFiscal — Sistema de Gestão Fiscal"

# ==============================================================================
# URL DA API — como funciona:
#
# 1. MESMA ORIGEM (recomendado em nuvem): deixe VITE_API_URL vazio.
#    Frontend e backend sob o mesmo domínio (Nginx/reverse proxy roteia
#    /api para o Laravel). Nenhuma configuração de CORS necessária.
#
# 2. DOMÍNIOS SEPARADOS: defina a URL completa do backend.
#    Ex.: VITE_API_URL="https://api.sgfiscal.com.br"
#    Nesse caso, configure também FRONTEND_URL no backend/.env
#
# Em desenvolvimento local o proxy do Vite usa este valor
# (padrão: http://localhost/backend — Laragon).
# ==============================================================================
VITE_API_URL=
