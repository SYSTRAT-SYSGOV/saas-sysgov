{
  "name": "sysgov",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/start-dev.js",
    "dev:admin": "npm --workspace apps/web run dev",
    "dev:client": "npm --workspace apps/web-client run dev",
    "dev:all": "concurrently -n admin,client -c magenta,green \"npm run dev:admin\" \"npm run dev:client\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
